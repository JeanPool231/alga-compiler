matrix A[2][3] = [[2,1,5],[1,-1,1]];
scalar i;
scalar j;
scalar k;
scalar pivote;
scalar factor;
scalar valido = 1;
for (k = 0; k < 2; k = k + 1) {
    if (valido == 1) {
        pivote = A[k][k];
        if (pivote != 0) {
            for (j = 0; j < 3; j = j + 1) {
                A[k][j] = A[k][j] / pivote;
            }
            for (i = 0; i < 2; i = i + 1) {
                if (i != k) {
                    factor = A[i][k];
                    for (j = 0; j < 3; j = j + 1) {
                        A[i][j] = A[i][j] - factor * A[k][j];
                    }
                }
            }
        } else { valido = 0; }
    }
}
if (valido == 1) {
    print(A[0][2]);
    print(A[1][2]);
} else { print("Pivote cero: este ejemplo requiere pivoteo"); }
